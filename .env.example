# ---- Server ----
PORT=3000
# Public HTTPS address of this server (your cloudflared/ngrok URL). Used in card links.
PUBLIC_URL=http://localhost:3000

# ---- NIPOST ----
# mock = built-in fake NIPOST using fixtures (no keys needed, clearly labelled as mock)
# live = real NIPOST API (staging or production, depending on your keys)
NIPOST_MODE=mock
NIPOST_BASE_URL=https://api.postcode.gov.ng
# Secret key (nipost_test_... on staging). Server-side only. Never put it in web/.
NIPOST_SECRET_KEY=
# Lookup level your key is granted (1-3). Features degrade gracefully to L1.
NIPOST_MAX_LEVEL=3

# Optional: NIPOST web widget for the checkout page.
# Publishable key (nipost_pk_test_...) with http://localhost:3000 on its origin allowlist.
NIPOST_PUBLISHABLE_KEY=
# The web SDK is "publication pending"; build it from sdks/widget-js and serve it, then set its URL here.
NIPOST_WIDGET_SCRIPT_URL=
NIPOST_WIDGET_ENVIRONMENT=staging

# ---- Storage ----
# memory = no database needed (data lost on restart); postgres = use DATABASE_URL
STORE=memory
DATABASE_URL=postgres://postgres:devpass@localhost:5432/reach

# Secret used to hash phone numbers and provider ids. Change it.
HASH_SECRET=change-me-to-a-long-random-string

# ---- WhatsApp Cloud API (Meta) ----
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=choose-any-string
WA_API_VERSION=v21.0

# ---- Voice notes ----
# Directory of recorded clips per language: audio/en, audio/pcm
VOICE_ENABLED=true

# ---- Address search (/find/ page) ----
# mock = searches fixtures/demo-locations.json only (try "Lagos" or "demo")
# nominatim = OpenStreetMap geocoder. The public server allows about 1 request per second and
# needs a User-Agent that identifies you; it is for demos only. For the pilot, run your own
# Nominatim inside the Nigerian hosting zone and point GEOCODER_URL at it.
GEOCODER_MODE=mock
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=
GEOCODER_EMAIL=

# Map tiles for the /find/ page (OpenStreetMap's tiles are fine for a demo, not for heavy use)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Where to send people whose building NIPOST hasn't mapped yet
NIPOST_REGISTER_URL=https://postcode.gov.ng
